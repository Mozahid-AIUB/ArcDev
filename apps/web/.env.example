# Copy to .env.local and fill in. Never commit .env.local.

# Public address of the site. Used for canonical links, the sitemap and share previews.
# Any value other than https://arcdevltd.com hides the site from search engines (staging).
NEXT_PUBLIC_SITE_URL=https://arcdevltd.com

# Website requests are emailed here (Phase 1).
# Without SMTP_HOST, local development prints requests to the terminal instead;
# a production build refuses to accept a request it cannot deliver.
REQUEST_EMAIL_TO=
REQUEST_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
